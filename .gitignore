# Large scraped datasets and archives -- kept local, carried between machines
# as a zip rather than committed (size + Nexus API acceptable-use policy
# discourages rehosting bulk API-sourced data publicly). Everything under
# data/ is gitignored regardless of subfolder.
data/

# nexus_bg3_scraper.py's own --output-dir default ("./bg3_nexus_data") is
# CWD-relative and deliberately NOT anchored into data/ (a known follow-up
# item -- see CLAUDE.md). Ignored explicitly here so a default-flags run
# doesn't leave an unignored multi-hundred-MB directory at repo root.
bg3_nexus_data/

*.log

# Secrets
.env
# nexus_auth_state.json now lives under data/nexus/ -- already covered by
# the data/ pattern above.

# Manually-synced local mirror of the shared Google Drive folder (Codex handoff)
Google Drive/

# Python
__pycache__/
*.pyc
venv/
.venv/

# Playwright
test-results/
.playwright-mcp/

# Personal Claude Code tooling (not part of this project)
.claude/
tools/
